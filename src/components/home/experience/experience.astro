---
import Eyebrow from '@/components/shared/eyebrow/eyebrow.astro'
import ActivityCard from '@/components/home/experience/activity-card'
import ExperienceTimeline from '@/components/home/experience/experience.tsx'
---

<section id='experience' class='min-w-0 border-b py-8 sm:py-16 lg:py-24'>
  <div class='mx-auto max-w-7xl space-y-8 px-4 sm:px-6 lg:space-y-16 lg:px-10.5'>
    <div class='space-y-2'>
      <Eyebrow text='Stacks & Experience' />
      <h2 class='text-2xl font-semibold md:text-3xl lg:text-4xl'>Where i'm good and where i learned from</h2>
    </div>

    <!-- client:only — cells are randomized per render; SSR + hydration would mismatch -->
    <ActivityCard client:only='react' />

    <ExperienceTimeline client:visible />
  </div>
</section>
