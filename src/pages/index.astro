---
import Layout from '@/layouts/Layout.astro'
import Hero from '@/components/home/hero/hero.astro'
import About from '@/components/home/about/about.astro'
import FeaturedWorks from '@/components/shared/featured-works/featured-works.astro'
import Experience from '@/components/home/experience/experience.astro'
import Services from '@/components/shared/services/services'
import Testimonials from '@/components/shared/testimonials/testimonials'
import HireMe from '@/components/home/hire-me/hire-me.astro'
import SelectService from '@/components/home/select-service/select-service.astro'

import { getCaseStudies } from '@/lib/case-studies'

const caseStudies = await getCaseStudies()

const pageTitle = 'Zolt - Portfolio Landing page'
const pageDescription =
  'Zolt is a free modern Shadcn UI Portfolio Template built with Astro for designers, developers, freelancers, and agencies to create fast, responsive, and SEO-friendly portfolio websites.'
const pageKeywords = 'portfolio template, astro template, shadcn ui, design engineer, freelancer portfolio'

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Zolt Mercer',
      description: 'Design engineer based in Austin.',
      inLanguage: 'en-US'
    }
  ]
}
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} schema={schema}>
  <Hero />
  <About />
  <FeaturedWorks caseStudies={caseStudies} />
  <Experience />
  <Services client:visible />
  <Testimonials client:visible />
  <HireMe />
  <SelectService />
</Layout>
