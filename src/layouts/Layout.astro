---
import '@/styles/global.css'

import { ClientRouter } from 'astro:transitions'

import HeadSeo from '@/layouts/HeadSeo.astro'
import EdgeBlur from '@/components/layout/edge-blur.astro'
import Footer from '@/components/layout/footer.astro'
import DownloadButton from '@/components/layout/download-button.astro'
import NavDock from '@/components/layout/nav-dock'
import CustomCursor from '@/components/layout/custom-cursor'
import ScrollProfileToast from '@/components/layout/scroll-profile-toast'
import { Toaster } from '@/components/ui/sonner'

interface Props {
  title?: string
  description?: string
  image?: string
  type?: 'website' | 'article'
  keywords?: string
  author?: string
  publishedTime?: string
  modifiedTime?: string
  noindex?: boolean
  nofollow?: boolean
  schema?: Record<string, any>
}

const seoProps = Astro.props as Props
---

<!doctype html>
<html lang='en' class='scroll-smooth antialiased'>
  <head>
    <HeadSeo {...seoProps} />
    <ClientRouter />
    <script is:inline>
      ;(function () {
        const getTheme = () => {
          if (typeof localStorage !== 'undefined') {
            const stored = localStorage.getItem('theme')
            if (stored === 'light' || stored === 'dark') {
              return stored
            }
          }
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
        }

        const applyTheme = () => {
          const theme = getTheme()
          if (theme === 'dark') {
            document.documentElement.classList.add('dark')
          } else {
            document.documentElement.classList.remove('dark')
          }
        }

        // Apply theme immediately on initial load
        applyTheme()

        // Re-apply theme on Astro page transitions
        document.addEventListener('astro:page-load', applyTheme)
      })()
    </script>
    <style>
      /* Disable all view transitions while keeping client-side navigation */
      ::view-transition-group(*),
      ::view-transition-old(*),
      ::view-transition-new(*) {
        animation-duration: 0ms !important;
      }
    </style>
  </head>
  <body class='flex min-h-full w-full flex-auto flex-col'>
    <div class='flex h-full w-full min-w-0 flex-col'>
      <main class='mx-auto flex w-full max-w-4xl min-w-0 flex-1 flex-col *:scroll-mt-15.5 lg:border-x xl:max-w-245'>
        <slot />
      </main>

      <Footer />
    </div>

    <EdgeBlur />
    <Toaster client:load />
    <ScrollProfileToast client:load pathname={Astro.url.pathname} />
    <NavDock client:load pathname={Astro.url.pathname} />
    <CustomCursor client:load />
    <DownloadButton />
  </body>
</html>
